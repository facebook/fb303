# Exposes the fb303 source tree (incl. the detail/, thrift/ and github/
# sub-packages) so the conda fb303 feedstock can build OSS fb303 from the
# in-fbsource sources via local_source_tree. Mirrors fbsource//xplat/folly:src-tree.
# @fb-only[end= ]: fb_native.export_file(
    # @fb-only[end= ]: name = "src-tree",
    # @fb-only[end= ]: src = ".",
    # @fb-only[end= ]: mode = "reference",
    # @fb-only[end= ]: visibility = ["PUBLIC"],
# @fb-only[end= ]: )

